---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';

const posts = await getCollection('blog', ({ data }) => {
  return data.pubDate <= new Date();
});

posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="TheCodePapers"
  description="Blog personal minimalista sobre desarrollo, programación y tecnología. Tutoriales, mejores prácticas y arquitectura de software."
>
  <Header slot="header" />
  <main id="main-content" class="blog-index-main" transition:animate="fade" role="feed" aria-label="Lista de publicaciones">
    {posts.length > 0 ? (
      <section class="blog-posts-list" aria-label="Publicaciones recientes">
        {posts.map((post) => (
          <article class="post-card-wrapper">
            <PostCard post={post} />
          </article>
        ))}
      </section>
    ) : (
      <section class="blog-empty-state" aria-label="Sin publicaciones">
        <p>No hay publicaciones todavía.</p>
        <p class="empty-hint">Crea un archivo <code>.md</code> en <code>src/content/blog/</code> para empezar.</p>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .blog-index-main {
    max-width: var(--max-width-prose);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
  }

  .blog-posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .blog-empty-state {
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
    color: var(--color-text-primary);
  }

  .blog-empty-state p {
    margin-bottom: var(--space-md);
  }

  .empty-hint {
    font-size: var(--text-sm);
  }

  .empty-hint code {
    font-size: 0.875em;
  }

  @media (max-width: 640px) {
    .blog-index-main {
      padding: var(--space-xl) var(--space-md);
    }
  }
</style>