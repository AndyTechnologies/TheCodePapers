---
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <p class="site-description">
    Blog personal minimalista sobre desarrollo, programación y tecnología.
  </p>
  <p class="copyright">
    TheCodePapers
  </p>
</footer>

<style>
  .site-footer {
    padding: 2rem;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-primary);
    text-align: center;
  }

  .site-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .copyright {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 1.5rem 1rem;
    }

    .site-description {
      font-size: 0.875rem;
    }
  }
</style>