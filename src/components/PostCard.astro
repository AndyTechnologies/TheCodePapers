---
interface Props {
  post: {
    id: string;
    slug: string;
    data: {
      title: string;
      description?: string;
      pubDate: Date;
      updatedDate?: Date;
      author: string;
      tags: string[];
    };
  };
}

const { post } = Astro.props;
const { id, data } = post;
const baseUrl = import.meta.env.BASE_URL;
const postUrl = `${baseUrl}/blog/${id}/`;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

const pubDate = formatDate(data.pubDate);
const updatedDate = data.updatedDate ? formatDate(data.updatedDate) : pubDate;
const hasUpdate = data.updatedDate && data.updatedDate.getTime() !== data.pubDate.getTime();
---

<article class="post-card">
  <header class="post-card-header">
    <h2 class="post-card-title">
      <a href={postUrl} class="post-link">{data.title}</a>
    </h2>
    <div class="post-card-meta">
      <time datetime={data.pubDate.toISOString()} class="post-date">
        Publicado: {pubDate}
      </time>
      {hasUpdate && (
        <time datetime={data.updatedDate!.toISOString()} class="post-date post-updated">
          Actualizado: {updatedDate}
        </time>
      )}
      <span class="post-author">Por {data.author}</span>
    </div>
  </header>

  {data.description && (
    <p class="post-card-excerpt">{data.description}</p>
  )}

  {data.tags.length > 0 && (
    <footer class="post-card-tags">
      {data.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </footer>
  )}
</article>

<style>
  .post-card {
    padding: var(--space-lg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-primary);
    transition: border-color var(--transition-base);
  }

  .post-card:hover {
    border-color: var(--color-border-hover);
  }

  .post-card-header {
    margin-bottom: var(--space-md);
  }

  .post-card-title {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-md);
  }

  .post-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: text-decoration var(--transition-base), text-decoration-color var(--transition-base);
    text-underline-offset: var(--space-xs);
    text-decoration-thickness: var(--border-width);
  }

  .post-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-text-primary);
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  .post-date::before {
    content: '';
  }

  .post-updated::before {
    content: '';
  }

  .post-author::before {
    content: '';
  }

  .post-card-excerpt {
    margin: 0;
    color: var(--color-text-primary);
    line-height: var(--leading-normal);
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--color-border);
  }

  @media (max-width: 640px) {
    .post-card {
      padding: var(--space-md);
    }

    .post-card-title {
      font-size: var(--text-lg);
    }

    .post-card-meta {
      gap: var(--space-sm);
      font-size: var(--text-xs);
    }
  }
</style>