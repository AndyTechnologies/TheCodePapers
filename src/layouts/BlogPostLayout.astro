---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
}

const { title, description, pubDate, updatedDate, author, tags } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : formattedPubDate;
const hasUpdate = updatedDate && updatedDate.getTime() !== pubDate.getTime();

// SEO props for BaseLayout
const publishedTime = pubDate.toISOString();
const modifiedTime = updatedDate ? updatedDate.toISOString() : pubDate.toISOString();
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  tags={tags}
>
  <Header slot="header" />
  <main id="main-content" class="blog-post-main" transition:animate="fade" role="article" aria-labelledby="post-title">
    <article class="blog-post">
      <header class="blog-post-header">
        <h1 id="post-title" class="blog-post-title">{title}</h1>
        <div class="blog-post-meta">
          <time datetime={pubDate.toISOString()} class="post-date">
            Publicado: {formattedPubDate}
          </time>
          {hasUpdate && (
            <time datetime={updatedDate!.toISOString()} class="post-date post-updated">
              Actualizado: {formattedUpdatedDate}
            </time>
          )}
          <span class="post-author">Por {author}</span>
        </div>
        {tags.length > 0 && (
          <div class="blog-post-tags" aria-label="Etiquetas">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>
      <div class="blog-post-content">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .blog-post-main {
    max-width: var(--max-width-prose);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
  }

  .blog-post {
    background-color: var(--color-bg-primary);
  }

  .blog-post-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .blog-post-title {
    font-size: var(--text-6xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-md);
    color: var(--color-text-primary);
  }

  .blog-post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .blog-post-content {
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
  }

  .blog-post-content h2 {
    font-size: var(--text-4xl);
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: var(--border-width) solid var(--color-border);
  }

  .blog-post-content h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .blog-post-content h3 {
    font-size: var(--text-2xl);
    margin-top: var(--space-xl);
  }

  .blog-post-content p {
    margin-bottom: var(--space-lg);
  }

  .blog-post-content ul,
  .blog-post-content ol {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-lg);
  }

  .blog-post-content li {
    margin-bottom: var(--space-xs);
  }

  .blog-post-content blockquote {
    margin: var(--space-xl) 0;
    padding: var(--space-lg);
  }

  .blog-post-content pre {
    margin: var(--space-xl) 0;
  }

  .blog-post-content code {
    font-size: 0.9em;
  }

  .blog-post-content hr {
    margin: var(--space-2xl) 0;
  }

  .blog-post-content img {
    margin: var(--space-xl) 0;
  }

  .blog-post-content table {
    margin: var(--space-xl) 0;
  }

  @media (max-width: 640px) {
    .blog-post-main {
      padding: var(--space-xl) var(--space-md);
    }

    .blog-post-title {
      font-size: var(--text-4xl);
    }

    .blog-post-meta {
      gap: var(--space-md);
      font-size: var(--text-sm);
    }

    .blog-post-content {
      font-size: var(--text-base);
    }

    .blog-post-content h2 {
      font-size: var(--text-2xl);
    }

    .blog-post-content h3 {
      font-size: var(--text-xl);
    }
  }
</style>