---
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const baseUrl = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://andytechnologies.github.io';
const fullOgImage = ogImage ? new URL(ogImage, siteUrl).toString() : undefined;

// Keywords for SEO
const siteKeywords = [
  'desarrollo de software',
  'programación',
  'web development',
  'software engineering',
  'Astro',
  'TypeScript',
  'JavaScript',
  'frontend',
  'backend',
  'WebAssembly',
  'blog técnico',
  'tutoriales programación',
  'mejores prácticas desarrollo',
  'arquitectura software',
  'devops',
  'CI/CD',
];

const pageKeywords = tags?.length ? [...tags, ...siteKeywords] : siteKeywords;
const keywordsString = [...new Set(pageKeywords)].join(', ');

// JSON-LD structured data
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ogType === 'article' ? 'BlogPosting' : 'WebSite',
  name: 'TheCodePapers',
  url: siteUrl,
  description: description || 'Blog personal minimalista sobre desarrollo, programación y tecnología. Tutoriales, mejores prácticas y arquitectura de software.',
  inLanguage: 'es-ES',
  publisher: {
    '@type': 'Organization',
    name: 'TheCodePapers',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}${baseUrl}/favicon.svg`,
    },
    sameAs: [
      'https://github.com/AndyTechnologies',
    ],
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
  ...(ogType === 'article' && {
    headline: title,
    datePublished: publishedTime,
    dateModified: modifiedTime || publishedTime,
    author: {
      '@type': 'Person',
      name: author || 'Andy García Fonticoba',
      url: `${siteUrl}/about`,
    },
    articleSection: 'Tecnología',
    keywords: tags?.join(', '),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalURL.toString(),
    },
  }),
};
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="TheCodePapers RSS Feed" href={`${baseUrl}/rss.xml`} />
    <link rel="preload" as="font" crossorigin href={`${baseUrl}/_astro/Montserrat-VariableFont_wght.DcaoeaBt.ttf`} />
    <link rel="preload" as="font" crossorigin href={`${baseUrl}/_astro/NotoSansMono-VariableFont_wdth_wght.CwK9lmmZ.ttf`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="view-transition" content="same-origin" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#F5F5F7" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={`${baseUrl}/sitemap-index.xml`} />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="keywords" content={keywordsString} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="TheCodePapers" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />
    {fullOgImage && <meta property="og:image" content={fullOgImage} />}
    {fullOgImage && <meta property="og:image:width" content="1200" />}
    {fullOgImage && <meta property="og:image:height" content="630" />}
    {fullOgImage && <meta property="og:image:alt" content={title} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    {tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    {ogType === 'article' && <meta property="article:section" content="Tecnología" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AndyTechnologies" />
    <meta name="twitter:creator" content="@AndyTechnologies" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {fullOgImage && <meta name="twitter:image" content={fullOgImage} />}
    {fullOgImage && <meta name="twitter:image:alt" content={title} />}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <div class="page-wrapper">
      <header role="banner">
        <slot name="header" />
      </header>
      <nav role="navigation" aria-label="Navegación principal">
        <slot name="navigation" />
      </nav>
      <main id="main-content" role="main">
        <slot />
      </main>
      <footer role="contentinfo">
        <slot name="footer" />
      </footer>
    </div>
    <Footer />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>